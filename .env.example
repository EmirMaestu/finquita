# Copiá este archivo a .env y completá los valores. .env no se sube al repo.
DATABASE_URL=postgres://mostrador:mostrador@localhost:5432/mostrador
# Base aparte para los tests de integración (se limpia en cada test).
TEST_DATABASE_URL=postgres://mostrador:mostrador@localhost:5432/mostrador_test
PORT=3000
BETTER_AUTH_SECRET=cambiame-por-un-secreto-largo
BETTER_AUTH_URL=http://localhost:5173
# Web Push (generá las claves con: bunx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dueno@example.com
# Open Food Facts
OFF_USER_AGENT=Mostrador/0.1 (dueno@example.com)
# Producción
DOMAIN=almacen.example.com
# Fotos de remitos y comprobantes (en producción, un volumen con backup)
FILES_DIR=data/files
# ── Producción (infra/docker-compose.prod.yml) ──────────────────────────────
# Contraseña de Postgres (solo dentro de la red de Docker).
POSTGRES_PASSWORD=cambiame-por-una-contraseña-larga
# Dónde están las imágenes que construye el CI y qué versión correr.
REGISTRY=ghcr.io/tu-usuario/mostrador
TAG=latest
# Copias con restic a un bucket externo (por ejemplo, Backblaze B2).
RESTIC_REPOSITORY=b2:nombre-del-bucket:mostrador
RESTIC_PASSWORD=cambiame-y-guardala-fuera-del-servidor
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# Opcional: URL de Uptime Kuma (push) para avisar si falla la copia.
BACKUP_PING_URL=

# Panel de soporte en /api/admin. Vacío o con menos de 16 caracteres = apagado.
ADMIN_PASSWORD=
# Commit que está corriendo (lo pone el deploy) y carpeta de las copias que lista el panel.
APP_VERSION=dev
BACKUPS_DIR=/backups
