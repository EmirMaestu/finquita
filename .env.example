# Copiá este archivo a .env y completá los valores. .env no se sube al repo.
DATABASE_URL=postgres://mostrador:mostrador@localhost:5432/mostrador
# Base aparte para los tests de integración (se limpia en cada test).
TEST_DATABASE_URL=postgres://mostrador:mostrador@localhost:5432/mostrador_test
PORT=3000
BETTER_AUTH_SECRET=cambiame-por-un-secreto-largo
BETTER_AUTH_URL=http://localhost:5173
# Web Push (generá las claves con: bunx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dueno@example.com
# Open Food Facts
OFF_USER_AGENT=Mostrador/0.1 (dueno@example.com)
# Producción
DOMAIN=almacen.example.com
# Fotos de remitos y comprobantes (en producción, un volumen con backup)
FILES_DIR=data/files
